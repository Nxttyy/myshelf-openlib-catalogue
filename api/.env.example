DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
SECRET_KEY=your-secret-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional. Where Google sign-in lands afterwards; empty = this server.
# For local dev with the React app (web/), point it at Vite:
# FRONTEND_URL=http://localhost:5173
# The site's public address, for links in emails and link previews.
# PUBLIC_URL=https://dora.you.et

# S3-compatible storage — comment photo uploads
S3_ENDPOINT_URL=https://your-endpoint.example.com
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=your-email@gmail.com
