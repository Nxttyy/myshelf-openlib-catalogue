{
  "name": "dora-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "mkdir -p node_modules/.tmp && (cd ../api && venv/bin/python -m scripts.dump_openapi) > node_modules/.tmp/openapi.json && npx --yes openapi-typescript@7 node_modules/.tmp/openapi.json -o src/api/schema.d.ts",
    "dev:phone": "PHONE=1 vite"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "barcode-detector": "^3.2.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
